# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hackmate?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/hackmate

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_hackmate_2025
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Notifications (Nodemailer)
# If credentials are not set, a safe console preview is logged without crashing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=HackMate <no-reply@hackmate.dev>

